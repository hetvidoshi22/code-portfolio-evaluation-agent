# Copy to .env.local (Next.js) / export in your shell (Python) and fill in.
# .env and .env.local are gitignored. Never commit a real token.

# Optional but strongly recommended for any deployment.
# Without it GitHub allows 60 requests/hour per IP, which a shared serverless IP
# exhausts almost immediately. A token raises this to 5,000 requests/hour.
# Create one at https://github.com/settings/tokens with NO scopes selected —
# public repository metadata needs no permissions at all.
GITHUB_TOKEN=

# Optional. Canonical site URL, used for Open Graph tags.
# On Vercel this is derived from VERCEL_URL automatically; set it only if you
# have a custom domain.
NEXT_PUBLIC_SITE_URL=
